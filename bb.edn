{:paths ["impl/clojure/src" "examples"]
 :tasks
 {todo    {:doc "Run the durable todo example under babashka (args: [path] [--reset])"
           :requires ([dacite.examples.todo :as todo])
           :task (apply todo/-main *command-line-args*)}
  config  {:doc "Run the config example (file store; --url is JVM-only)"
           :requires ([dacite.examples.config :as cfg])
           :task (apply cfg/-main *command-line-args*)}
  notes   {:doc "Run the versioned notes example (file store)"
           :requires ([dacite.examples.notes :as notes])
           :task (apply notes/-main *command-line-args*)}
  log     {:doc "Run the event-log example (file store)"
           :requires ([dacite.examples.event-log :as elog])
           :task (apply elog/-main *command-line-args*)}
  sync    {:doc "Run the directory/blob sync example (file store)"
           :requires ([dacite.examples.sync :as sync])
           :task (apply sync/-main *command-line-args*)}
  parity  {:doc "Print the canonical root hash (for cross-host parity)"
           :requires ([dacite.examples.parity :as parity])
           :task (apply parity/-main *command-line-args*)}}}
