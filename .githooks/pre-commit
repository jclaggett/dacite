#!/bin/bash
# Dacite pre-commit hook
# Runs clj-kondo linter and cljfmt formatter check on Clojure source files

set -e

CLJ_DIR="impl/clojure"

echo "Running cljfmt check..."
cd "$(git rev-parse --show-toplevel)/$CLJ_DIR"

# Get staged Clojure files relative to impl/clojure
STAGED_CLJ=$(git diff --cached --name-only --diff-filter=ACM -- "*.clj" "*.cljc" "*.cljs" 2>/dev/null | grep -E '\.(clj|cljc|cljs)$' || true)

if [ -n "$STAGED_CLJ" ]; then
    if ! clojure -M:fmt check $STAGED_CLJ 2>/dev/null; then
        echo ""
        echo "❌ cljfmt check failed!"
        echo "Run 'cd $CLJ_DIR && clojure -M:fmt fix' to auto-format, then re-stage."
        exit 1
    fi
    echo "✅ cljfmt check passed."
else
    echo "No staged Clojure files to format-check."
fi

cd "$(git rev-parse --show-toplevel)"

echo ""
echo "Running clj-kondo linter..."

# Check if clj-kondo is available
if ! command -v clj-kondo &> /dev/null; then
    echo "Warning: clj-kondo not installed. Skipping lint check."
    echo "Install with: curl -sLO https://raw.githubusercontent.com/clj-kondo/clj-kondo/master/script/install-clj-kondo"
    exit 0
fi

# Run linter on source and test directories
cd "$(git rev-parse --show-toplevel)"

LINT_RESULT=0
if [ -d "impl/clojure/src" ]; then
    echo "Linting src..."
    clj-kondo --lint impl/clojure/src || LINT_RESULT=$?
fi

if [ -d "impl/clojure/test" ]; then
    echo "Linting test..."
    clj-kondo --lint impl/clojure/test || LINT_RESULT=$?
fi

if [ $LINT_RESULT -ne 0 ]; then
    echo ""
    echo "❌ Linting failed. Please fix the errors above before committing."
    exit 1
fi

echo "✅ Linting passed."
exit 0
