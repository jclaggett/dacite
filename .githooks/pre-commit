#!/bin/bash
# Dacite pre-commit hook
# Runs cljfmt formatter check and clj-kondo linter on Clojure source files

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
CLJ_DIR="$REPO_ROOT/impl/clojure"

run_fmt_check() {
    echo "Running cljfmt check..."

    # Get staged Clojure files (paths relative to repo root)
    local staged_files
    staged_files=$(git diff --cached --name-only --diff-filter=ACM -- "*.clj" "*.cljc" "*.cljs" 2>/dev/null | grep -E '\.(clj|cljc|cljs)$' || true)

    if [ -z "$staged_files" ]; then
        echo "No staged Clojure files to format-check."
        return 0
    fi

    # Strip impl/clojure/ prefix for cljfmt (which runs from CLJ_DIR)
    local relative_files
    relative_files="${staged_files//impl\/clojure/.}"

    if ! (cd "$CLJ_DIR" && clojure -M:fmt check $relative_files 2>/dev/null); then
        echo ""
        echo "❌ cljfmt check failed!"
        echo "Run 'cd impl/clojure && clojure -M:fmt fix' to auto-format, then re-stage."
        return 1
    fi

    echo "✅ cljfmt check passed."
}

run_lint_check() {
    echo ""
    echo "Running clj-kondo linter..."

    if ! (cd "$CLJ_DIR" && clojure -M:lint 2>&1); then
        echo ""
        echo "❌ Linting failed. Please fix the errors above before committing."
        return 1
    fi

    echo "✅ Linting passed."
}

fun_test_check() {
    echo ""
    echo "Running unit tests..."

    if ! (cd "$CLJ_DIR" && clojure -A:dev -M:test 2>&1); then
        echo ""
        echo "❌ Unit tests failed. Please fix the errors above before committing."
        return 1
    fi

    echo "✅ All unit tests passed."
}

# Run checks
run_fmt_check &&
    run_lint_check &&
    fun_test_check
