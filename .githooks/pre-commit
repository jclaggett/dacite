#!/bin/bash
# Dacite pre-commit hook
# Runs cljfmt formatter check and clj-kondo linter on Clojure source files

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
CLJ_DIR="$REPO_ROOT/impl/clojure"

run_fmt_check() {
    echo "Running cljfmt check..."

    # Get staged Clojure files (paths relative to repo root)
    local staged_files
    staged_files=$(git diff --cached --name-only --diff-filter=ACM -- "*.clj" "*.cljc" "*.cljs" 2>/dev/null | grep -E '\.(clj|cljc|cljs)$' || true)

    if [ -z "$staged_files" ]; then
        echo "No staged Clojure files to format-check."
        return 0
    fi

    # Strip impl/clojure/ prefix for cljfmt (which runs from CLJ_DIR).
    # Repo-root examples/ live outside impl/clojure — use a relative path back.
    local relative_files=""
    while IFS= read -r f; do
        case "$f" in
            impl/clojure/*)
                relative_files="$relative_files ${f#impl/clojure/}"
                ;;
            examples/*)
                relative_files="$relative_files ../../$f"
                ;;
            *)
                relative_files="$relative_files $f"
                ;;
        esac
    done <<< "$staged_files"

    if ! (cd "$CLJ_DIR" && clojure -M:fmt check $relative_files 2>/dev/null); then
        echo ""
        echo "❌ cljfmt check failed!"
        echo "Run 'cd impl/clojure && clojure -M:fmt fix' to auto-format, then re-stage."
        return 1
    fi

    echo "✅ cljfmt check passed."
}

run_lint_check() {
    echo ""
    echo "Running clj-kondo linter..."

    if ! (cd "$CLJ_DIR" && clojure -M:lint 2>&1); then
        echo ""
        echo "❌ Linting failed. Please fix the errors above before committing."
        return 1
    fi

    echo "✅ Linting passed."
}

run_test_check() {
    echo ""
    echo "Running unit tests..."

    if ! (cd "$CLJ_DIR" && clojure -M:dev:cov 2>&1); then
        echo ""
        echo "❌ Unit tests failed. Please fix the errors above before committing."
        return 1
    fi

    echo "✅ All unit tests passed."
}

run_book_build() {
    local staged_files
    staged_files=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null \
        | grep -E '^(docs/book/|docs/site/|scripts/build-site\.sh|\.github/workflows/pages\.yml)' || true)

    if [ -z "$staged_files" ]; then
        return 0
    fi

    echo ""
    echo "Building site (book + landing)..."

    local script_bin="$REPO_ROOT/scripts/bin"
    if [ -d "$script_bin" ]; then
        export PATH="$script_bin:$PATH"
    fi

    if ! command -v mdbook >/dev/null 2>&1 || ! command -v mdbook-mermaid >/dev/null 2>&1; then
        echo "❌ mdbook and mdbook-mermaid are required when book/site files change."
        echo "   Install: cargo install mdbook mdbook-mermaid"
        echo "   Or:      brew install mdbook && cargo install mdbook-mermaid"
        return 1
    fi

    if ! bash "$REPO_ROOT/scripts/build-site.sh"; then
        echo ""
        echo "❌ Site build failed. Fix book errors before committing."
        return 1
    fi

    echo "✅ Site build passed."
}

# Run checks
run_fmt_check &&
    run_lint_check &&
    run_test_check &&
    run_book_build
