{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.4"}
        cheshire/cheshire {:mvn/version "5.13.0"}
        org.lmdbjava/lmdbjava {:mvn/version "0.9.3"}}
 
 :aliases
 {:dev {:extra-paths ["dev" "test" "../../examples"]
        :extra-deps {org.clojure/test.check {:mvn/version "1.1.3"}}}
  
  :test {:extra-paths ["test" "../../examples"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :jvm-opts ["--add-opens" "java.base/java.nio=ALL-UNNAMED"
                    "--add-opens" "java.base/sun.nio.ch=ALL-UNNAMED"]
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  
  ;; NOTE: the networked example stack (:server / :cli) was archived to
  ;; impl/clojure/archive/examples/ along with dacite.service, pending a
  ;; service design doc. See docs/design/stores-phase-1.md item 5.

  ;; Cards example: clojure -M:cards
  :cards {:jvm-opts ["--add-opens" "java.base/java.nio=ALL-UNNAMED"
                     "--add-opens" "java.base/sun.nio.ch=ALL-UNNAMED"]
          :main-opts ["-e" "(load-file \"../../examples/cards.clj\") (examples.cards/-main)"]}

  ;; Remote config: same domain against file or HTTP
  ;;   clojure -M:config -- show
  ;;   clojure -M:config -- --path target/dacite-config set timeout 60
  ;;   clojure -M:config -- --url http://127.0.0.1:8080 show
  :config {:extra-paths ["../../examples"]
           :jvm-opts ["--add-opens" "java.base/java.nio=ALL-UNNAMED"
                      "--add-opens" "java.base/sun.nio.ch=ALL-UNNAMED"]
           :main-opts ["-m" "dacite.examples.config"]}

  ;; Versioned notes: snapshots, restore, sharing bench
  ;;   clojure -M:notes -- --reset show
  ;;   clojure -M:notes -- set title Hello
  ;;   clojure -M:notes -- list
  ;;   clojure -M:notes -- restore 1
  ;;   clojure -M:notes -- bench
  :notes {:extra-paths ["../../examples"]
          :jvm-opts ["--add-opens" "java.base/java.nio=ALL-UNNAMED"
                     "--add-opens" "java.base/sun.nio.ch=ALL-UNNAMED"]
          :main-opts ["-m" "dacite.examples.notes"]}

  ;; Event log: append-only ledger + derived view
  ;;   clojure -M:log -- --reset show
  ;;   clojure -M:log -- page 0
  ;;   clojure -M:log -- append credit 5 coffee
  ;;   clojure -M:log -- bench
  :log {:extra-paths ["../../examples"]
        :jvm-opts ["--add-opens" "java.base/java.nio=ALL-UNNAMED"
                   "--add-opens" "java.base/sun.nio.ch=ALL-UNNAMED"]
        :main-opts ["-m" "dacite.examples.event-log"]}

  ;; Directory / blob sync
  ;;   clojure -M:sync -- --reset seed
  ;;   clojure -M:sync -- ls
  ;;   clojure -M:sync -- cat readme.txt
  ;;   clojure -M:sync -- --url http://127.0.0.1:8080 push
  :sync {:extra-paths ["../../examples"]
         :jvm-opts ["--add-opens" "java.base/java.nio=ALL-UNNAMED"
                    "--add-opens" "java.base/sun.nio.ch=ALL-UNNAMED"]
         :main-opts ["-m" "dacite.examples.sync"]}

  ;; HTTP service + static todo web UI
  ;;   cd impl/clojure && clojure -M:service
  ;;   clojure -M:service --port 8080 --store mem
  ;;   clojure -M:service --port 8080 --store file
  ;;   clojure -M:service --port 8080 --store file:target/dacite-service
  ;;   clojure -M:service --port 8080 --store lmdb
  ;;   clojure -M:service --port 8080 --store lmdb:target/my-lmdb
  :service {:extra-paths ["../../examples"]
            :jvm-opts ["--add-opens" "java.base/java.nio=ALL-UNNAMED"
                       "--add-opens" "java.base/sun.nio.ch=ALL-UNNAMED"]
            :main-opts ["-m" "dacite.service.main"]}

  ;; Compile browser bundle (portable core + todo-web)
  ;;   cd impl/clojure && clojure -M:cljs-web
  ;; Compile browser bundle (whitespace optim — reliable for this demo)
  ;;   cd impl/clojure && clojure -M:cljs-web
  :cljs-web {:extra-paths ["../../examples"]
             :extra-deps {org.clojure/clojurescript {:mvn/version "1.11.132"}}
             :main-opts ["-e" "(require '[cljs.build.api :as b]) (b/build (b/inputs \"src\" \"../../examples\") {:main 'dacite.examples.todo-web :output-to \"../../examples/web/js/main.js\" :output-dir \"../../examples/web/js/out\" :asset-path \"/app/js/out\" :optimizations :whitespace :pretty-print true}) (println \"Wrote examples/web/js/main.js\")"]}

  ;; Compile explorer UI
  ;;   cd impl/clojure && clojure -M:cljs-explorer
  :cljs-explorer {:extra-paths ["../../examples"]
                  :extra-deps {org.clojure/clojurescript {:mvn/version "1.11.132"}}
                  :main-opts ["-e" "(require '[cljs.build.api :as b]) (b/build (b/inputs \"src\" \"../../examples\") {:main 'dacite.examples.explorer-web :output-to \"../../examples/web/explorer/js/main.js\" :output-dir \"../../examples/web/explorer/js/out\" :asset-path \"/app/explorer/js/out\" :optimizations :whitespace :pretty-print true}) (println \"Wrote examples/web/explorer/js/main.js\")"]}
  
  :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.12"}}
          :ns-default build}
  
  ;; Linting: clojure -M:lint
  :lint {:extra-deps {clj-kondo/clj-kondo {:mvn/version "2026.01.19"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"]}
  
  ;; Code formatting: clojure -M:fmt check (or fix)
  :fmt {:extra-deps {dev.weavejester/cljfmt {:mvn/version "0.15.6"}}
        :main-opts ["-m" "cljfmt.main"]}
  
  ;; Check for outdated dependencies: clojure -M:outdated
  :outdated {:extra-deps {antq/antq {:mvn/version "2.11.1276"}}
             :main-opts ["-m" "antq.core"]}
  
  ;; Code coverage: clojure -M:dev:cov
  :cov {:extra-deps {cloverage/cloverage {:mvn/version "1.2.4"}}
        :jvm-opts ["--add-opens" "java.base/java.nio=ALL-UNNAMED"
                   "--add-opens" "java.base/sun.nio.ch=ALL-UNNAMED"]
        :main-opts ["-m" "cloverage.coverage"
                    "-p" "src"
                    "-s" "test"]}}}
