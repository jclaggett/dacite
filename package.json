{
  "name": "dacite-sci",
  "version": "0.2.0-alpha",
  "private": true,
  "description": "Run the portable Dacite core under nbb (SCI on Node).",
  "scripts": {
    "hello": "nbb -m dacite.examples.hello",
    "parity": "nbb -m dacite.examples.parity",
    "parity:test": "nbb -cp impl/clojure/src:impl/clojure/test -m dacite.parity.checks",
    "parity:suite": "bash bin/parity.sh",
    "todo": "nbb -m dacite.examples.todo-ui",
    "todo:batch": "nbb -m dacite.examples.todo",
    "config": "nbb -m dacite.examples.config",
    "notes": "nbb -m dacite.examples.notes",
    "log": "nbb -m dacite.examples.event-log",
    "sync": "nbb -m dacite.examples.sync",
    "lmdb:v1": "LMDB_DATA_V1=true npx --yes node-gyp rebuild --directory node_modules/lmdb",
    "store:test": "nbb -cp impl/clojure/src:impl/clojure/test -m dacite.store.durable-cljs-test",
    "mem:test": "nbb -cp impl/clojure/src:impl/clojure/test -m dacite.store.mem-cljs-test",
    "lru:test": "nbb -cp impl/clojure/src:impl/clojure/test -m dacite.store.lru-cljs-test",
    "lmdb:bench": "nbb -m dacite.examples.lmdb-bench",
    "idb:test": "nbb -cp impl/clojure/src:impl/clojure/test -m dacite.store.idb-test",
    "reveal:test": "nbb -cp impl/clojure/src:impl/clojure/test -m dacite.reveal-cljs-test",
    "peer:test": "nbb -cp impl/clojure/src:impl/clojure/test -m dacite.peer.peer-cljs-test",
    "items:test": "nbb -cp impl/clojure/src:impl/clojure/test -m dacite.peer.items-cljs-test",
    "webrtc:test": "nbb -cp impl/clojure/src:impl/clojure/test -m dacite.peer.webrtc-cljs-test",
    "webrtc:transfer": "node scripts/webrtc-transfer.mjs",
    "webrtc:signal": "node scripts/webrtc-signal-server.mjs",
    "webrtc:signal-test": "node scripts/webrtc-signal-test.mjs",
    "peer:build": "cd impl/clojure && node ../../node_modules/shadow-cljs/cli/runner.js compile peer",
    "browser:test": "cd impl/clojure && node ../../node_modules/shadow-cljs/cli/runner.js compile peer-node && node target/peer-node.js",
    "peer:e2e": "node scripts/peer-browser-e2e.mjs",
    "browser:build": "cd impl/clojure && node ../../node_modules/shadow-cljs/cli/runner.js compile browser",
    "browser:e2e": "node scripts/browser-e2e.mjs",
    "library:build": "cd impl/clojure && clojure -M:cljs-library",
    "library:e2e": "node scripts/library-peer-e2e.mjs"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "node-datachannel": "^0.33.6",
    "prompts": "^2.4.2",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "fake-indexeddb": "6.2.7",
    "nbb": "^1.3.196",
    "playwright": "^1.65.0",
    "shadow-cljs": "2.28.23"
  },
  "allowScripts": {
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  },
  "optionalDependencies": {
    "lmdb": "^3.5.6"
  }
}
